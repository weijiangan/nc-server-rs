# /etc/nc-server/nc-server.env
#
# Optional runtime overrides for nc-server.service (loaded via
# EnvironmentFile=).  Every key is optional — packaged defaults work
# without this file.

# Location of the PHP bootstrap shim.  Only needed when the shim is not at
# the compiled-in packaged default (/usr/share/nc-server/php-shim/index.php).
#NC_PHP_SHIM=/usr/share/nc-server/php-shim/index.php

# PHP CLI interpreter used to parse config/config.php and probe imagick at
# startup.  Overrides 'php_binary' in config.php — the only way to change
# the interpreter that parses config.php itself.  Default: php.
#NC_PHP_BINARY=php-legacy

# FastCGI socket fallback — 'fastcgi_socket' in config/config.php wins.
#NC_FASTCGI_SOCKET=/run/nc-fpm.sock

# Log verbosity (tracing-subscriber EnvFilter syntax).
#RUST_LOG=info
#RUST_LOG=nc_fastcgi=debug,info
